{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/auth", "destination": "/auth.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" }
  ],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 10
    }
  }
}
